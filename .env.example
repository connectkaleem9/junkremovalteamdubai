# Copy to .env and fill in. Never commit .env.
#
# On the server this file lives at  ~/appdata/.env  (outside the web root, so it
# can never be downloaded). Locally it can sit in the project root.

APP_ENV=production             # development | staging | production
APP_DEBUG=false                # must stay false in production
APP_URL=https://junkremovalteamdubai.com
APP_TIMEZONE=Asia/Dubai

# 32+ random characters. Used to hash visitor IPs and sign form timestamps.
# Generate with:  php -r "echo bin2hex(random_bytes(24));"
APP_KEY=

# Database — create it in the Hostinger control panel, then paste the details.
# Leave blank and the site still works: leads are emailed and written to
# ~/appdata/leads/YYYY-MM.jsonl until the database exists.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Email. MAIL_FROM_ADDRESS must be an address on this domain or the host
# will refuse to send. The customer's own address is used as Reply-To.
MAIL_FROM_ADDRESS=noreply@junkremovalteamdubai.com
MAIL_FROM_NAME="Junk Removal Team Dubai"
LEAD_NOTIFY_EMAIL=contact.junkremovalteam@gmail.com

# Analytics — leave blank until the accounts exist
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_SITE_VERIFICATION=
