# Copy to .env and fill in. Never commit .env.

APP_ENV=development            # development | staging | production
APP_DEBUG=true                 # must be false in production
APP_URL=https://junkremovalteamdubai.com
APP_DEFAULT_LOCALE=en
APP_TIMEZONE=Asia/Dubai

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=junkremoval
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=jrtd_session
SESSION_SECURE=true
SESSION_LIFETIME_MINUTES=120

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Junk Removal Team Dubai"
LEAD_NOTIFY_EMAIL=contact.junkremovalteam@gmail.com

UPLOAD_MAX_MB=8
UPLOAD_MAX_FILES=5

RATE_LIMIT_FORM_PER_HOUR=10
RATE_LIMIT_LOGIN_ATTEMPTS=5

GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_SITE_VERIFICATION=
