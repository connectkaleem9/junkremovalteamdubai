# Junk Removal Team Dubai — server rules
#
# Everything here is deliberately small. The host already forces HTTPS and
# already adds a trailing slash to directory URLs, so those rules are not
# repeated.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One hostname only. Without this, www.junkremovalteamdubai.com serves the
  # whole site a second time and Google has to guess which one is real.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# Our own 404 instead of the host's bare error page, so a visitor who lands on
# a dead URL still sees the menu and a way to contact us.
ErrorDocument 404 /404.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
